# =============================================================
# ObserveAll Environment Variables
# Copy to .env and fill in your credentials
# NEVER commit .env to source control
# =============================================================

# ── Datadog ──────────────────────────────────────────────────
DD_API_KEY=
DD_SITE=datadoghq.com

# ── Dynatrace ─────────────────────────────────────────────────
DT_API_TOKEN=
DT_ENDPOINT=https://{env-id}.live.dynatrace.com

# ── Grafana Cloud ─────────────────────────────────────────────
# Format: base64(instanceId:token)
GRAFANA_TOKEN=

# ── New Relic ─────────────────────────────────────────────────
NR_LICENSE_KEY=

# ── Custom OTLP ───────────────────────────────────────────────
CUSTOM_OTLP_ENDPOINT=
